# Copy to fastlane/.env (git-ignored) or export these in your shell before `fastlane mac metadata`
# and `fastlane mac submit`. App Review uses them to reach you; they're never committed.
HEADROOM_REVIEW_FIRST_NAME=
HEADROOM_REVIEW_LAST_NAME=
HEADROOM_REVIEW_PHONE=
HEADROOM_REVIEW_EMAIL=

# Optional: the App Store Connect API key, when it isn't at ~/.appstoreconnect/api_key.json.
# Either a path to a fastlane-format JSON file or the JSON itself:
# {"key_id": "...", "issuer_id": "...", "key_filepath": "~/.appstoreconnect/private_keys/AuthKey_XXXX.p8", "in_house": false}
# ASC_KEY_JSON=
