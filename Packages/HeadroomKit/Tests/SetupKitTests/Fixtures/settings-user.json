{
  "model": "opus",
  "env": {
    "EXAMPLE_FLAG": "1",
    "EMPTY": ""
  },
  "permissions": {
    "allow": ["Bash(ls:*)", "Read(/tmp/example/**)"],
    "deny": []
  },
  "enabledPlugins": {
    "example-plugin@example-market": true,
    "other-plugin@example-market": false
  },
  "cleanupPeriodDays": 30,
  "ratio": 2.5,
  "nothing": null,
  "unicode": "café → ok / slash",
  "nested": {
    "deep": {
      "list": [1, 2.5, null, "a/b", {"k": "v"}, [true, false]]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "~/bin/example-guard.sh --strict", "timeout": 10}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "afplay /System/Library/Sounds/Glass.aiff"}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {"type": "command", "command": "example-formatter --write \"$FILE\""}
        ]
      }
    ]
  }
}
