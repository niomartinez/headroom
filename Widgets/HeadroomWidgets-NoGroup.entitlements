<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  The widget extension in Debug and ad-hoc builds: sandboxed, no App Group, so it shows "Open Headroom" and never
  touches a container (1.1 §5.1).
-->
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
